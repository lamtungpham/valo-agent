# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.
# Không có key thì app vẫn chạy: số liệu do engine tính, Coach dùng lời dẫn mẫu có ghi nhãn.

# AI của sản phẩm: CHỈ dùng Muse Spark qua Meta Model API (tương thích OpenAI Chat Completions)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Adapter Valo thật (P1). Để trống thì dùng mock hư cấu Mr. Sample.
# Cách 1: API trả JSON định dạng valo-financial-context v4.0 tại GET {VALO_API_BASE_URL}/financial-context
VALO_API_BASE_URL=
VALO_API_TOKEN=
# Cách 2: file JSON xuất từ Valo (định dạng valo-financial-context v4.0)
VALO_CONTEXT_FILE=

# Cổng web
PORT=3000
# Ngân sách token cho mỗi lần gọi (Muse Spark suy luận ngầm trước khi viết, nên cần đủ lớn)
META_MAX_TOKENS=8000
# Tuỳ chọn: low | medium | high. Đặt low để Muse Spark suy luận ít hơn, trả lời nhanh hơn (bỏ trống = mặc định của API)
META_REASONING_EFFORT=
